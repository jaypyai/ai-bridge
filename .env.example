# Copy to .env or export these before running bridge_server.py.
# Never commit real secrets.

# 256-bit hex secret. The voice agent never sees it; you type it once on the
# OAuth approve page to prove it's really you completing the grant.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_SECRET=

# Port and bind address for the bridge server.
BRIDGE_PORT=8133
BRIDGE_BIND=127.0.0.1

# For poll.py / reply.py: SSH target and remote dir of the bridge host.
BRIDGE_HOST=bridge-host
BRIDGE_DIR=/opt/ai-bridge
